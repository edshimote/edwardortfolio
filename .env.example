# Copy to .env.local for development, or set in the deploy platform's dashboard for production.
# Never commit a real .env/.env.local file — it's already gitignored.

# Public site URL, used for canonical/OG/sitemap/robots. Set to the real production domain once
# one exists (custom domain or the *.vercel.app URL Vercel assigns on deploy).
NEXT_PUBLIC_SITE_URL=https://eduardo-dev.vercel.app

# Contact form delivery (server-only). Without this set, the form correctly shows its
# "unconfigured" state and never fakes a success — see src/app/api/contact/route.ts.
# Any endpoint that accepts a JSON POST works (Formspree, Make, n8n, a custom Resend-backed route).
CONTACT_FORM_WEBHOOK_URL=
# Optional bearer token sent as `Authorization: Bearer <token>` to the webhook above.
CONTACT_FORM_WEBHOOK_TOKEN=

# Optional, privacy-respecting analytics. Leave unset to ship with no analytics at all (default).
# Plausible (no cookies, no personal data): set your domain to enable the script in layout.tsx.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
